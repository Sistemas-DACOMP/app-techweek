rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || request.auth.token.admin == true || (request.auth.token.email != null && request.auth.token.email in ['sam03amorim@gmail.com']));
    }

    function isStaffOrAdmin() {
      return isAdmin() || (isAuthenticated() && request.auth.token.role == 'STAFF');
    }

    // Regras de Usuários: Todos autenticados leem; só o próprio dono cria/atualiza dados pessoais
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && !('symplaTicket' in request.resource.data) && !('hasSymplaTicket' in request.resource.data) &&
        !('sponsorId' in request.resource.data) && !('companyId' in request.resource.data) &&
        !('company' in request.resource.data) && !('empresa' in request.resource.data) && !('companyName' in request.resource.data) && !('termsAcceptedAt' in request.resource.data) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'PARTICIPANT') &&
        (!('totalPoints' in request.resource.data) || request.resource.data.totalPoints == 0) &&
        (!('pontuacaoTotal' in request.resource.data) || request.resource.data.pontuacaoTotal == 0);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'termsAcceptedAt', 'uid', 'createdAt', 'totalPoints', 'pontuacaoTotal', 'symplaTicket', 'hasSymplaTicket', 'sponsorId', 'companyId', 'company', 'empresa', 'companyName', 'jobTitle']));
      // Conta vinculada a patrocinador não se apaga/recria pelo client (recriar escolhendo company* contornaria o vínculo).
      allow delete: if isOwner(userId) && !('sponsorId' in resource.data);
      // Achado do security review (KAN-60): "allow write: if isAdmin()" deixava
      // qualquer sessão ADMIN escrever QUALQUER campo (inclusive role) direto
      // pelo client, contornando PUT /api/admin/users/:uid/role (que sincroniza
      // custom claim + Firestore juntos, com divergência relatada explicitamente
      // se algo falhar). Fabio confirmou: toda troca de role passa pelo backend
      // — write:false força isso, mesmo padrão já usado em bookings/leads/checkins.

      // Histórico de pontos de missão/desafio (KAN-79, POST /api/points/claim).
      // Regra do documento pai não cobre subcollection — sem isso aqui, a
      // leitura cai no default-deny e o histórico nunca aparece pro dono.
      match /point_events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Apenas backend via Firebase Admin SDK
      }
    }

    // Índice de unicidade de ingresso Sympla (KAN-108): só o backend (Admin SDK) escreve/lê.
    match /symplaTickets/{ticketId} {
      allow read, write: if false;
    }

    // Patrocinadores (KAN-124): leitura só ADMIN ou membro da equipe; escrita só pelo backend (Admin SDK).
    match /sponsors/{sponsorId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && exists(/databases/$(database)/documents/sponsors/$(sponsorId)/members/$(request.auth.uid)));
      allow write: if false;

      match /members/{memberUid} {
        allow read: if isAdmin() || isOwner(memberUid);
        allow write: if false;
      }
    }

    // Convites de patrocinador: só ADMIN lê (tokenHash nunca sai pro client de outros); escrita só backend.
    match /sponsorInvites/{inviteId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Regras de Atividades: Leitura pública autenticada; escrita apenas para ADMIN
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Catálogo de missões/desafios (KAN-80): mesmo padrão de activities —
    // ADMIN escreve/edita direto pelo Firestore (sem admin-web ainda pra
    // isso). POST /api/points/claim (backend/src/routes/points.ts) usa o
    // Admin SDK, que ignora esta regra — ela protege o write client-side.
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Segredos de missões (palavras-chave, gabaritos de quizzes): apenas backend via Admin SDK
    match /mission_secrets/{missionId} {
      allow read, write: if false;
    }

    // Regras de Comunicados: Leitura pública autenticada; escrita apenas para ADMIN
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Regras de Reservas: leitura e criação/remoção pelo próprio participante autenticado ou ADMIN
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /leads/{sponsorId}/contacts/{contactId} {
      allow read: if isAuthenticated() && (request.auth.uid == sponsorId || isAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras de Pontos: cada usuário lê os próprios eventos; escrita sempre pelo backend
    match /pointEvents/{eventId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras de Check-ins (double-check de presença): leitura restrita ao participante ou Staff/ADMIN
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isStaffOrAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Patrocinador: papel vem do claim OU do doc do usuário (o doc só é escrito pelo
    // backend, ver regra de /users), porque contas antigas podem ter o papel só no doc.
    function isSponsorUser() {
      return isAuthenticated() && (
        request.auth.token.role == 'SPONSOR' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SPONSOR')
      );
    }

    // Likes: o único campo que qualquer autenticado pode mexer, e só o próprio uid.
    function onlyOwnLikeChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
        request.resource.data.likes is list &&
        request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid]) &&
        resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid]);
    }

    // Regras do Feed de Notícias e Comunidade.
    // Antes: read/create/update/delete eram `if true`, ou seja, qualquer pessoa, até
    // sem login, podia criar, editar e apagar posts. Agora:
    //  - leitura: só autenticado;
    //  - criar: ADMIN/STAFF (posts da organização) ou patrocinador (posts de patrocinador),
    //    sempre com authorUid == uid de quem escreve e authorRole coerente com o papel;
    //  - editar: ADMIN (fixar etc.) ou qualquer autenticado só pra curtir/descurtir;
    //  - apagar: ADMIN, ou o próprio autor (patrocinador apagando o que postou).
    match /feed_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorUid == request.auth.uid
        && (
          (isStaffOrAdmin() && request.resource.data.authorRole == 'ORGANIZATION')
          || (isSponsorUser() && request.resource.data.authorRole == 'SPONSOR')
        )
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && (!('likes' in request.resource.data) || request.resource.data.likes.size() == 0);
      allow update: if isAdmin() || (isAuthenticated() && onlyOwnLikeChanged());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.get('authorUid', '') == request.auth.uid);
    }

    // Regras de Ranking / Leaderboard consolidado
    match /ranking/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
