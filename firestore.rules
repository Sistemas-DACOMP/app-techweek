rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || request.auth.token.admin == true);
    }

    function isStaffOrAdmin() {
      return isAdmin() || (isAuthenticated() && request.auth.token.role == 'STAFF');
    }

    // Regras de Usuários: Todos autenticados leem; só o próprio dono cria/atualiza dados pessoais
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == 'PARTICIPANT') &&
        (!('totalPoints' in request.resource.data) || request.resource.data.totalPoints == 0) &&
        (!('pontuacaoTotal' in request.resource.data) || request.resource.data.pontuacaoTotal == 0);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'termsAcceptedAt', 'uid', 'createdAt', 'totalPoints', 'pontuacaoTotal']));
      allow delete: if isOwner(userId);
      // Achado do security review (KAN-60): "allow write: if isAdmin()" deixava
      // qualquer sessão ADMIN escrever QUALQUER campo (inclusive role) direto
      // pelo client, contornando PUT /api/admin/users/:uid/role (que sincroniza
      // custom claim + Firestore juntos, com divergência relatada explicitamente
      // se algo falhar). Fabio confirmou: toda troca de role passa pelo backend
      // — write:false força isso, mesmo padrão já usado em bookings/leads/checkins.

      // Histórico de pontos de missão/desafio (KAN-79, POST /api/points/claim).
      // Regra do documento pai não cobre subcollection — sem isso aqui, a
      // leitura cai no default-deny e o histórico nunca aparece pro dono.
      match /point_events/{eventId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Apenas backend via Firebase Admin SDK
      }
    }

    // Regras de Atividades: Leitura pública autenticada; escrita apenas para ADMIN
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Catálogo de missões/desafios (KAN-80): mesmo padrão de activities —
    // ADMIN escreve/edita direto pelo Firestore (sem admin-web ainda pra
    // isso). POST /api/points/claim (backend/src/routes/points.ts) usa o
    // Admin SDK, que ignora esta regra — ela protege o write client-side.
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Segredos de missões (palavras-chave, gabaritos de quizzes): apenas backend via Admin SDK
    match /mission_secrets/{missionId} {
      allow read, write: if false;
    }

    // Regras de Comunicados: Leitura pública autenticada; escrita apenas para ADMIN
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Regras de Reservas: leitura e criação/remoção pelo próprio participante autenticado ou ADMIN
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /leads/{sponsorId}/contacts/{contactId} {
      allow read: if isAuthenticated() && (request.auth.uid == sponsorId || isAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras de Pontos: cada usuário lê os próprios eventos; escrita sempre pelo backend
    match /pointEvents/{eventId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras de Check-ins (double-check de presença): leitura restrita ao participante ou Staff/ADMIN
    match /checkins/{checkinId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isStaffOrAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras do Feed de Notícias e Comunidade
    match /feed_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() || true;
      allow delete: if isAuthenticated() || true;
    }

    // Regras de Ranking / Leaderboard consolidado
    match /ranking/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
