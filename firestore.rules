rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(userId) {
      return isOwner(userId) && request.auth.token.email_verified == true;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || request.auth.token.admin == true);
    }

    function isStaffOrAdmin() {
      return isAdmin() || (isAuthenticated() && request.auth.token.role == 'STAFF');
    }

    function isSponsor() {
      return isAuthenticated() && request.auth.token.role == 'SPONSOR';
    }

    // Whitelist de campos permitidos para criação e atualização do perfil do usuário
    function userAllowedCreateKeys() {
      return [
        'uid', 'email', 'firstName', 'lastName', 'displayName',
        'username', 'phone', 'participantType', 'participant_type',
        'course', 'period', 'institution', 'linkedin', 'instagram',
        'github', 'avatarUrl', 'photoURL', 'mascot', 'role',
        'totalPoints', 'pontuacaoTotal', 'termsAcceptedAt',
        'createdAt', 'updatedAt'
      ];
    }

    function userAllowedUpdateKeys() {
      return [
        'firstName', 'lastName', 'displayName', 'username', 'phone',
        'participantType', 'participant_type', 'course', 'period',
        'institution', 'linkedin', 'instagram', 'github', 'avatarUrl',
        'photoURL', 'mascot', 'email', 'updatedAt', 'pendingEmailChange'
      ];
    }

    function isValidParticipantType(val) {
      return val == null || (val is string && val in [
        'Aluno UFU Graduação', 'Aluno UFU Pós-graduação', 'Aluno de outra instituição',
        'Servidor / Professor', 'Professor / Servidor UFU', 'Comunidade Externa',
        'Outro', 'Aluno da UFU', 'Pós-graduação', 'Aluno UFU Pos graduação', 'Organizador'
      ]);
    }

    function isValidPendingEmailChange(val) {
      return val == null || (
        val is map
        && 'newEmail' in val && val.newEmail is string && val.newEmail.size() <= 150 && val.newEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && 'requestedAt' in val && (val.requestedAt is int || val.requestedAt is number || val.requestedAt is timestamp)
        && 'expiresAt' in val && (val.expiresAt is int || val.expiresAt is number || val.expiresAt is timestamp)
      );
    }

    function isValidUserFields(data) {
      return (!('username' in data) || (data.username is string && (data.username == '' || (data.username.size() >= 3 && data.username.size() <= 30 && data.username.matches('^[a-zA-Z0-9._]+$')))))
        && (!('period' in data) || data.period == null || (data.period is int && data.period >= 1 && data.period <= 20))
        && (!('participantType' in data) || isValidParticipantType(data.participantType))
        && (!('participant_type' in data) || isValidParticipantType(data.participant_type))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 100))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 100))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('course' in data) || (data.course is string && data.course.size() <= 100))
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 100))
        && (!('mascot' in data) || (data.mascot is string && data.mascot.size() <= 50))
        && (!('linkedin' in data) || data.linkedin == null || (data.linkedin is string && data.linkedin.size() <= 500))
        && (!('instagram' in data) || data.instagram == null || (data.instagram is string && data.instagram.size() <= 500))
        && (!('github' in data) || data.github == null || (data.github is string && data.github.size() <= 500))
        && (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('pendingEmailChange' in data) || isValidPendingEmailChange(data.pendingEmailChange));
    }

    // Regras de Usuários: Todos autenticados leem; só o próprio dono cria/atualiza dados pessoais com whitelist estrita
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'role', 'totalPoints', 'pontuacaoTotal', 'termsAcceptedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(userAllowedCreateKeys())
        && request.resource.data.uid == userId
        && request.resource.data.role == 'PARTICIPANT'
        && request.resource.data.totalPoints == 0
        && request.resource.data.pontuacaoTotal == 0
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && isValidUserFields(request.resource.data);

      allow update: if isVerifiedOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userAllowedUpdateKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) || (request.resource.data.email is string && request.auth.token.email != null && request.resource.data.email.lower() == request.auth.token.email.lower()))
        && isValidUserFields(request.resource.data);

      allow delete: if isOwner(userId);
      // Achado do security review (KAN-60): "allow write: if isAdmin()" deixava
      // qualquer sessão ADMIN escrever QUALQUER campo (inclusive role) direto
      // pelo client, contornando PUT /api/admin/users/:uid/role (que sincroniza
      // custom claim + Firestore juntos, com divergência relatada explicitamente
      // se algo falhar). Fabio confirmou: toda troca de role passa pelo backend
      // — write:false força isso, mesmo padrão já usado em bookings/leads/checkins.

      // Histórico de pontos de missão/desafio (KAN-79, POST /api/points/claim).
      // Regra do documento pai não cobre subcollection — sem isso aqui, a
      // leitura cai no default-deny e o histórico nunca aparece pro dono.
      match /point_events/{eventId} {
        allow read: if isVerifiedOwner(userId) || isAdmin();
        allow write: if false; // Apenas backend via Firebase Admin SDK
      }
    }

    // Índice de unicidade de ingresso Sympla (KAN-108): só o backend (Admin SDK) escreve/lê.
    match /symplaTickets/{ticketId} {
      allow read, write: if false;
    }

    // Regras de Atividades: Leitura pública autenticada; escrita apenas para ADMIN
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Catálogo de missões/desafios (KAN-80): mesmo padrão de activities —
    // ADMIN escreve/edita direto pelo Firestore (sem admin-web ainda pra
    // isso). POST /api/points/claim (backend/src/routes/points.ts) usa o
    // Admin SDK, que ignora esta regra — ela protege o write client-side.
    match /missions/{missionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Segredos de missões (palavras-chave, gabaritos de quizzes): apenas backend via Admin SDK
    match /mission_secrets/{missionId} {
      allow read, write: if false;
    }

    // Regras de Comunicados: Leitura pública autenticada; escrita apenas para ADMIN
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Regras de Reservas: leitura e criação/remoção pelo próprio participante autenticado com e-mail verificado ou ADMIN
    match /bookings/{bookingId} {
      allow read: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow delete: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
    }

    match /leads/{sponsorId}/contacts/{contactId} {
      allow read: if isAuthenticated() && (request.auth.uid == sponsorId || isAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras de Pontos: cada usuário com e-mail verificado lê os próprios eventos; escrita sempre pelo backend
    match /pointEvents/{eventId} {
      allow read: if (isVerified() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras de Check-ins (double-check de presença): leitura restrita ao participante verificado ou Staff/ADMIN
    match /checkins/{checkinId} {
      allow read: if (isVerified() && resource.data.uid == request.auth.uid) || isStaffOrAdmin();
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    // Regras do Feed de Notícias e Comunidade
    match /feed_posts/{postId} {
      allow read: if true;

      // Criação: Staff/Admin (tolerante para legado sem authorId) ou Patrocinador (authorId obrigatório e sem campos reservados)
      // TODO: tornar authorId obrigatório após deploy do front
      allow create: if (
        (isStaffOrAdmin() && (!('authorId' in request.resource.data) || request.resource.data.authorId == request.auth.uid))
        ||
        (isSponsor()
          && ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid)
          && request.resource.data.authorRole == 'SPONSOR'
          && (!('pinned' in request.resource.data) || request.resource.data.pinned == false)
          && request.resource.data.get('likes', []).size() == 0
          && request.resource.data.get('likesCount', 0) == 0)
      );

      // Edição: Staff/Admin (livre) ou participante com e-mail verificado alterando unicamente o próprio like
      allow update: if isStaffOrAdmin() || (
        isVerified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.get('likes', []) is list
        && request.resource.data.get('likes', []).toSet()
             .difference(resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid])
        && resource.data.get('likes', []).toSet()
             .difference(request.resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid])
      );

      // Exclusão: Exclusivo para Staff/Admin
      allow delete: if isStaffOrAdmin();
    }

    // Regras de Ranking / Leaderboard consolidado
    match /ranking/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
