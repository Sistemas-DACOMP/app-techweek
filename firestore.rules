rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de segurança
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'ADMIN' || request.auth.token.admin == true);
    }

    // Regras de Usuários: Todos autenticados leem; só o próprio dono atualiza dados pessoais
    //
    // O `create` exige termsAcceptedAt como timestamp e role fixo em PARTICIPANT —
    // isso replica exatamente o que POST /api/auth/register grava (ver backend/src/services/registerUser.ts,
    // KAN-72/REG-LGPD-001). Sem essa trava, um client autenticado podia escrever
    // /users/{uid} direto pelo SDK, pulando o backend inteiro: sem aceite de LGPD
    // registrado e, mais grave, podendo se auto-atribuir qualquer role (inclusive
    // ADMIN) na criação — o `allow update` já bloqueava troca de role depois, mas
    // nada bloqueava isso no create. O backend usa o Admin SDK, que ignora estas
    // regras, então essa trava não afeta o fluxo oficial de cadastro.
    //
    // uid/email/hasOnly: achado do security-reviewer (KAN-72) — sem isso, o create
    // (ainda preso ao próprio uid via isOwner) deixava gravar uid/email arbitrários
    // e campos extra no próprio doc. uid tem que bater com o token; email só pode
    // ser o do token ou null (cobre contas sem claim de email, ex. telefone).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.email == null || request.resource.data.email == request.auth.token.email)
        && request.resource.data.termsAcceptedAt is timestamp
        && request.resource.data.role == 'PARTICIPANT'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'role', 'termsAcceptedAt', 'createdAt']);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow write: if isAdmin();
    }

    // Regras de Atividades: Leitura pública autenticada; escrita apenas para ADMIN
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Regras de Comunicados: Leitura pública autenticada; escrita apenas para ADMIN
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Regras de Reservas e Leads: Escritas diretas do cliente proibidas (feitas pelo backend)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }

    match /leads/{sponsorId}/contacts/{contactId} {
      allow read: if isAuthenticated() && (request.auth.uid == sponsorId || isAdmin());
      allow write: if false; // Apenas backend via Firebase Admin SDK
    }
  }
}

