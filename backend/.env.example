# Segredo do HMAC do QR dinâmico do telão (KAN-51 — screenToken.ts).
# Obrigatório em qualquer ambiente que sirva GET /api/activities/:id/screen-token
# ou POST /api/checkin/checkout. Mínimo 32 caracteres (enforced em código —
# um segredo curto/fraco deixa o HMAC brute-forçável offline).
#
# Deploy local (emulador): pode ir num .env.local do backend/ ou export direto no shell.
# Deploy real (Cloud Function): hoje só funciona via env var simples
# (`firebase deploy --set-env-vars` ou config do console). Migrar pra Secret
# Manager (`defineSecret`, https://firebase.google.com/docs/functions/config-env#secret-manager)
# é recomendado antes de ir pra produção de verdade — não implementado ainda,
# ver achado do security review do KAN-51 (2026-09-21).
SCREEN_TOKEN_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# Convite de patrocinador (KAN-124 — services/emailService.ts). Valores reais
# só no ambiente do deploy, nunca versionados. Sem RESEND_API_KEY o envio de
# e-mail é pulado (API devolve emailSent:false e o admin usa "Copiar convite").
RESEND_API_KEY=
EMAIL_FROM=
# Endereço público do app, sem barra final e COM o caminho se não estiver na raiz
# (ex: https://sistemas-dacomp.github.io/app-techweek). Monta o link <base>/#/sponsor/invite/<token>.
APP_BASE_URL=
# Log temporario do IP do cliente (valida trust proxy em homolog); deixe vazio/desligado
DEBUG_CLIENT_IP=
